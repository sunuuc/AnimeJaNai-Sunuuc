<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MpvNet.Windows.WPF.DanmakuSourceEditWindow"
        Title="编辑弹幕线路" Width="560" SizeToContent="Height" MinWidth="460"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Foreground="{Binding Theme.Foreground}" Background="{Binding Theme.Background}"
        FontSize="14" Loaded="Window_Loaded">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="线路名称" FontWeight="SemiBold" />
        <TextBox x:Name="NameBox" Grid.Row="1" Margin="0,7,0,18" MaxLength="80" />
        <TextBlock Grid.Row="2" Text="线路地址" FontWeight="SemiBold" />
        <TextBox x:Name="UrlBox" Grid.Row="3" Margin="0,7,0,20" MaxLength="2048" />
        <TextBlock x:Name="Status" Grid.Row="4" Margin="0,0,0,10" TextWrapping="Wrap"
                   Foreground="{Binding Theme.Foreground2}" Visibility="Collapsed" />
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Padding="18,7" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="确定" IsDefault="True" Padding="22,7" Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>
